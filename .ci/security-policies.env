# Single source of truth for security thresholds.
#
# WHY THIS FILE EXISTS
# The security thresholds below are *recommendations* for the POC, not agreed
# company policy. They live here so a later decision is a one-line change that
# applies to every workflow, instead of an edit to three YAML files.
#
# Every consumer reads this file and echoes the values into its job summary, so
# a reviewer can always see which policy a green check was judged against.

# --- npm (frontend) -----------------------------------------------------
# npm audit always exits non-zero on *any* finding, so the gate needs to
# triage by severity itself rather than trusting the tool's exit code.
#
# Assumption: the runtime dependency graph is the part we ship, so HIGH and
# CRITICAL findings there block a merge. Dev/build-only findings are reported
# but not blocking, because for most tooling advisories no safe upgrade exists
# yet and a permanently-red gate trains people to ignore it.
# Recommendation for the team: confirm, then raise this to `moderate`.
NPM_BLOCKING_SEVERITY_PROD=critical,high
NPM_BLOCKING_SEVERITY_DEV=

# --- Go (backend) -------------------------------------------------------
# govulncheck is call-graph aware: it only reports vulnerabilities your code
# can actually reach. That is a much higher signal-to-noise ratio than a plain
# dependency list, so all reachable findings in third-party modules block.
#
# The Go standard library is treated separately (see below) and is documented
# in docs/security-baseline.md.
GO_BLOCK_REACHABLE_THIRD_PARTY=true

# A stdlib finding is fixed by bumping the Go toolchain, not by the author of
# the PR in front of you. Blocking an unrelated feature PR on it punishes the
# wrong person and stalls the queue.
#
# Assumption: stdlib findings are surfaced as annotations and recorded in the
# job summary. Bumping the pinned Go version is the fix, tracked as repo work.
# Recommendation for the team: decide who owns "bump the toolchain" and how
# fast it must happen, then decide whether this stays non-blocking.
GO_BLOCK_ON_STDLIB_FINDINGS=false

# --- Container image scanning ------------------------------------------
# Image scanning is comparatively slow and needs a warm vulnerability DB, so
# it runs in the scheduled workflow rather than on every PR. See
# docs/extending-the-gate.md.
IMAGE_SCAN_SEVERITY_THRESHOLD=HIGH
IMAGE_SCAN_BLOCK_ON_THRESHOLD=true

# --- Secret scanning ----------------------------------------------------
# A committed secret must be treated as compromised the moment it is pushed:
# rotate it first, then remove it. History rewriting alone does not help.
SECRETS_BLOCK_ON_ANY_FINDING=true
