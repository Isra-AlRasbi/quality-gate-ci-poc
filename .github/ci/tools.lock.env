# Pinned versions for the analysis tools CI installs itself.
#
# WHY PIN THESE
# A gate whose tool moves underneath it is not reproducible: an unpinned scanner
# can turn a green commit red overnight with no code change, which makes people
# distrust every red build, not just the true ones. Pinning also makes "why did
# this start failing?" answerable — diff this file.
#
# These are analyzers, not the application's toolchain, so they live apart from
# .tool-versions. Bump them deliberately, in their own commit.
#
# Every value here is checked for existence by scripts/ci/verify-toolchain-sync.sh.
GOVULNCHECK_VERSION=v1.10.0     # golang.org/x/vuln/cmd/govulncheck
GITLEAKS_IMAGE=ghcr.io/gitleaks/gitleaks:v8.30.1@sha256:c00b6bd0aeb3071cbcb79009cb16a60dd9e0a7c60e2be9ab65d25e6bc8abbb7f
ACTIONLINT_IMAGE=docker.io/rhysd/actionlint:1.7.12@sha256:b1934ee5f1c509618f2508e6eb47ee0d3520686341fec936f3b79331f9315667
