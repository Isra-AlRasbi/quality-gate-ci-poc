# Toolchain pin for GitHub Actions.
#
# GitHub Actions cannot read .tool-versions natively, so the pins are mirrored
# here for `uses:` inputs. The values MUST match .tool-versions.
#
# Drift between the two files is a real risk, so .github/workflows/ci-self-check.yml
# runs scripts/ci/verify-toolchain-sync.sh on every PR and fails with the exact
# command to fix it.
#
# Keep the comments on a single line: the parser in verify-toolchain-sync.sh
# takes everything after "# ".
NODE_VERSION=22.21.1         # .tool-versions: nodejs
GO_VERSION=1.26.11           # .tool-versions: golang
NODE_IMAGE=node:22.21.1-alpine@sha256:eefb407f08684593068a61d76c3336fb418bdfd184357ccfe448aadfa1147b3e
GO_BUILD_IMAGE=golang:1.26.11-alpine@sha256:f496f8c537ed506626ee1a6913afb32c45068a48697163c088f604cc775a0c38
NGINX_IMAGE=nginx:1.29.8-alpine@sha256:3bcf852aed06467cf075c6105892e4d5a6ebbbafa0ce22d35062db9e90ddef4c
